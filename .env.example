# ============================================
# Supabase Config - Caderno do Momo
# ============================================
# Para sincronizar entre dispositivos:
#
# 1. Acesse https://supabase.com e crie uma conta
# 2. Crie um projeto novo (ex: "caderno-momo")
# 3. No SQL Editor, rode este SQL para criar a tabela:
#
#    create table notebooks (
#      id text primary key,
#      sections jsonb default '[]',
#      pages jsonb default '[]',
#      desk_post_its jsonb default '[]',
#      updated_at timestamptz default now()
#    );
#
#    -- Ativar Realtime na tabela:
#    alter publication supabase_realtime add table notebooks;
#
# 4. Va em Settings > API e copie:
#    - Project URL
#    - anon/public key
#
# 5. Copie este arquivo como .env e preencha:
#
# Sem essas variaveis, o app funciona normalmente
# mas os dados ficam apenas no localStorage (local).
# ============================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
